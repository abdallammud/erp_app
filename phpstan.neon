includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app

    # Start lenient; raise as the codebase matures (see docs/build/DECISIONS.md).
    level: 5

    ignoreErrors:
        # App\Jobs\Concerns\TenantAware is built ahead of its first real
        # consumer — no queued job needs it yet, that arrives with Phase 1's
        # payroll runs and similar. Larastan can't analyse a trait it sees
        # zero usages of within `app/` (see the trait.unused identifier
        # docs), so it flags a false "unused" warning. It IS exercised and
        # proven correct by tests/Feature/Tenancy/TenantAwareQueueTest.php —
        # just not from `app/`. Remove this once a real job in `app/Jobs`
        # uses the trait (Phase 1).
        -
            identifier: trait.unused
            path: app/Jobs/Concerns/TenantAware.php

        # Larastan infers `$instance->status` as a plain `string` (the
        # raw migration column type) rather than the ApprovalStatus enum
        # declared in ApprovalInstance::casts() — it doesn't yet pick up
        # enum casts declared via the newer method-based `casts(): array`
        # syntax (only the older `protected $casts` property). Verified
        # empirically via tinker that the enum cast is genuinely applied
        # at runtime (`$instance->status` really is an ApprovalStatus
        # instance) before adding this — a real bug would have been fixed,
        # not ignored. Same pattern as the trait.unused entry above.
        -
            identifier: notIdentical.alwaysTrue
            path: app/Support/Approvals/ApprovalWorkflow.php
        -
            identifier: identical.alwaysFalse
            path: app/Support/Approvals/ApprovalWorkflow.php
        -
            identifier: deadCode.unreachable
            path: app/Support/Approvals/ApprovalWorkflow.php
