includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app

    # Start lenient; raise as the codebase matures (see docs/build/DECISIONS.md).
    level: 5

    ignoreErrors:
        # App\Jobs\Concerns\TenantAware is built ahead of its first real
        # consumer — no queued job needs it yet, that arrives with Phase 1's
        # payroll runs and similar. Larastan can't analyse a trait it sees
        # zero usages of within `app/` (see the trait.unused identifier
        # docs), so it flags a false "unused" warning. It IS exercised and
        # proven correct by tests/Feature/Tenancy/TenantAwareQueueTest.php —
        # just not from `app/`. Remove this once a real job in `app/Jobs`
        # uses the trait (Phase 1).
        -
            identifier: trait.unused
            path: app/Jobs/Concerns/TenantAware.php
